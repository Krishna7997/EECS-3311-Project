# .env.example - contains no real credentials.
# Copy this file to .env and put your own key in .env (which is git-ignored).
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Optional settings:
# LLM_MODEL=claude-haiku-5-5
# LLM_WORKSPACE_ID=   (only needed if the API asks for it; find it at platform.claude.com/settings/workspaces)
