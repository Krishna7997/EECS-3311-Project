    <panel_attributes>*MapleCfoFacade*
--
-txService, budgets, registered, fire, debtPlanner,
 recurring, alerts, history, eventBus, reports,
 accounts, netWorth, goals, affordability, cashFlow,
 agent, reminders, rrspEstimator, limits, settings,
 formatReader, queryParser, monthlyReview,
 budgetPlanner, extraMoney
--
F01/F02: importTransactions, importTransactionsAuto, detectImportFormat,
 getTransactions, findTransactions, searchTransactions, recategorize
F16: proposeImportFormat, saveFormatAndImport
F18: understandTransactionQuery
undo: undoLastEdit, redoLastEdit, canRedo, describeUndo
F04: setBudget, getBudgetStatus      F17: runMonthlyReview, suggestBudgets
F05: getRecurringCharges
F06/F14: getContributionRoom, previewContribution, checkContribution,
 recordContribution, getContributions, getRepaymentPlans, estimateRrspRoom
F07: projectFire, suggestFireInputs, lastFireInputs
F08: addDebt, getDebts, planDebtPayoff
F03: addAccount, updateAccountBalance, getAccounts, getNetWorthHistory,
 getAccountActivity, summarize
F09: createGoal, getGoals, forecastGoals    F11: checkAffordability
F19: planExtraMoney, explainExtraMoney
F10: askCfo, confirmProposedAction, dismissProposedAction, getPendingActions
F12: generateMonthlyReport
F13: getImportFolder, setImportFolder, newImportWatcher,
 isMonthlyCheckinDue, completeMonthlyCheckin, checkReminders
F15: describeLimits, refreshLimits</panel_attributes>
    <additional_attributes />
  </element>
