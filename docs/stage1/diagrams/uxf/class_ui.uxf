    <panel_attributes>*MapleCfoFacade*
--
-txService: TransactionService
-netWorth: NetWorthService
-budgets: BudgetService
-registered: RegisteredAccountService
-goals: GoalService
-fire: FireCalculator
-debtPlanner: DebtPayoffPlanner
-recurring: RecurringChargeDetector
-affordability: AffordabilityAnalyzer
-reports: ReportService
-autoSync: ImportFolderWatcher
-reminders: ReminderService
-limits: LimitsService
-rrspEstimator: RrspRoomEstimator
-agent: CfoAgent
-history: CommandHistory
-eventBus: EventBus
--
+importTransactions(p: Path, accountId: String, profile: String): ImportResult
+saveMappingProfile(m: ColumnMapping): void
+recategorize(txId: String, c: Category): void
+undoLastEdit(): boolean
+redoLastEdit(): boolean
+addAccount(a: Account): void
+updateAccountBalance(accountId: String, balance: Money): void
+getNetWorth(): NetWorthSnapshot
+setBudget(c: Category, limit: Money, m: YearMonth): void
+getBudgetStatus(m: YearMonth): List&lt;BudgetStatus&gt;
+getRecurringCharges(): List&lt;RecurringCharge&gt;
+checkContribution(t: AccountType, amt: Money): ContributionCheck
+getContributionRoom(t: AccountType, year: int): ContributionRoom
+projectFire(in: FireInputs): FireProjection
+planDebtPayoff(m: PayoffMethod, extra: Money): PayoffPlan
+createGoal(g: SavingsGoal): void
+forecastGoal(goalId: String): GoalForecast
+checkAffordability(amt: Money, d: LocalDate): AffordabilityResult
+askCfo(message: String): AgentResponse
+confirmProposedAction(actionId: String): void
+dismissProposedAction(actionId: String): void
+generateMonthlyReport(m: YearMonth): MonthlyReport
+subscribe(t: EventType, l: FinanceEventListener): void
+startAutoImport(folder: Path): void
+stopAutoImport(): void
+getReminders(): List&lt;Alert&gt;
+getRrspEstimate(year: int): RrspEstimate
+confirmRrspLimit(limit: Money): void
+refreshLimits(): LimitsStatus</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
